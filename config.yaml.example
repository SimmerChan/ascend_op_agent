# Ascend Op Agent 配置文件示例
# 复制此文件为 config.yaml 并填入实际值

# ============================================================
# LLM 配置
# ============================================================
llm:
  # LLM 提供商: openai / anthropic / local
  provider: "openai"
  # API 地址，支持 ${ENV_VAR} 环境变量引用
  api_base: "https://api.openai.com/v1"
  # API 密钥，使用环境变量引用
  api_key: "${OPENAI_API_KEY}"
  # 模型名称
  model: "gpt-4o"
  # 最大重试次数
  max_retries: 3
  # 请求超时时间（秒）
  timeout: 120

# ============================================================
# MCP 服务器配置
# ============================================================
mcp:
  servers:
    # stdio 模式 MCP 服务器
    - name: "code-search"
      type: "stdio"
      command: "npx"
      args: ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]

    # HTTP 模式 MCP 服务器
    - name: "github"
      type: "http"
      url: "https://api.github.com/mcp"
      token: "${GITHUB_TOKEN}"  # 环境变量引用

    # streamable-http 模式 MCP 服务器
    - name: "custom"
      type: "streamable-http"
      url: "http://localhost:8080"
      token: "${CUSTOM_TOKEN}"

# ============================================================
# 外部 Skill 仓库配置
# 注意: skill 安装通过交互式 CLI 选择，不在此处配置
# ============================================================
skill_repositories:
  - name: "ascend-community"
    url: "https://gitcode.com/ascend/agent-skills"
  - name: "custom-skills"
    url: "https://gitcode.com/user/custom-skills"

# ============================================================
# 远程开发环境配置
# ============================================================
remote:
  # SSH 连接信息
  host: "192.168.1.100"
  user: "root"
  port: 22
  key_path: "~/.ssh/id_rsa"
  password: "${SSH_PASSWORD}"  # 环境变量引用

  # 镜像/容器配置（可选）
  # - 无镜像无容器: 在宿主机环境开发
  # - 有镜像无容器: Agent 自主创建容器
  # - 有镜像有容器: 在指定容器内开发
  image_name: "ascend/pytorch:23.0"  # 可选，如不配置则在宿主机开发
  container_name: "agent-dev"  # 可选，如不配置则自动创建

# ============================================================
# 本地模式配置
# ============================================================
local:
  # 工作目录
  workspace: "./workspace"
  # Skill 存储路径
  skills_path: "~/.ascend_op_agent/skills"

# ============================================================
# Embedding 配置
# ============================================================
embedding:
  # Embedding 模型名称，支持 sentence-transformers 系列模型
  model: "${EMBEDDING_MODEL:-sentence-transformers/all-MiniLM-L6-v3}"

# ============================================================
# 向量存储配置
# ============================================================
vector_store:
  # ChromaDB 持久化目录
  persist_dir: "${VECTOR_STORE_DIR:-~/.ascend_op_agent/vector_db}"